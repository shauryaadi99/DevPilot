# ==============================================================================
# DevPilot Environment Configuration Template
# ==============================================================================

# Backend Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration
# Default to SQLite for zero-friction local development; easily swap to PostgreSQL:
# e.g., postgresql+psycopg://user:password@localhost:5432/devpilot
DATABASE_URL=sqlite:///./devpilot.db

# Groq LLM Configuration
# Obtain your free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30.0

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
